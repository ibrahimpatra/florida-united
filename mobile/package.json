{
  "name": "florida-kuwait-app",
  "version": "1.0.0",
  "private": true,
  "description": "Android / iOS shell for the Florida Kuwait store. It opens the live website inside the app, so every feature (shop, cart, checkout, account, returns, admin, assistant) is the same as the website and updates the moment you deploy.",
  "scripts": {
    "assets": "capacitor-assets generate --android --ios",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
