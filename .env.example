# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Florida United Kuwait"

# ─── Firebase ─────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here


# ─── Email (Nodemailer) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Florida United Kuwait <noreply@floridaunited.com.kw>"

# ─── WhatsApp Business ────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=96512345678

# ─── Stripe (card payments, charged in USD) ───────────────────
# Dashboard > Developers > API keys. Webhook endpoint: https://YOUR-DOMAIN/api/stripe/webhook
# events: checkout.session.completed, checkout.session.expired,
#         checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, charge.refunded
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Fallback KWD->USD rate (the value in Admin > Settings wins)
USD_RATE=3.25

# ─── Gemini AI agent (server only, never NEXT_PUBLIC_) ────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash   # gemini-2.0-flash was shut down by Google on 1 Jun 2026

# OpenAI (optional). NOT free: pay-as-you-go from platform.openai.com (gpt-4o-mini costs a fraction of a cent per product).
# Gemini answers customers and live buttons first; OpenAI does background jobs (SEO, bulk descriptions) first. Each backs up the other.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_BULK_PROVIDER=openai        (or gemini, who goes first for background jobs)

# ── WhatsApp Business Cloud API (Meta) ───────────────────────
# Get from: Meta Business Manager → WhatsApp → Getting Started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your store's WhatsApp number (for customer-facing "chat" links)
NEXT_PUBLIC_WHATSAPP_NUMBER=96522225050

# Secret for /api/cron/expire-card-orders (cancels card orders left unpaid for 2 hours).
# Vercel Hobby = 1 cron run per day (vercel.json); orders are also swept whenever a new order is placed.
# On Vercel, set CRON_SECRET in Environment Variables and Vercel sends it to the cron automatically.
CRON_SECRET=

# ─── Cloudflare R2 image storage (optional; Firebase Storage is used until these are set) ───
# Cloudflare dashboard > R2 > create bucket > Manage R2 API Tokens (Object Read & Write).
# R2_PUBLIC_URL is not needed any more (pictures are served from /media on your own domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Must start with https:// (an address without it made image links open as /shop/products/img.example.com/... = 404)
# R2_PUBLIC_URL is no longer needed: pictures are served from your own domain at /media/...

# --- Online card payment: set the keys of the provider(s) you want. No keys = no card option at checkout. ---
# Pick which one in Admin > Settings > Online card payment (Automatic uses the first with keys).
# STRIPE_SECRET_KEY=            (existing) + STRIPE_WEBHOOK_SECRET
# TAP_SECRET_KEY=               Tap Payments (charges in KWD)
# MYFATOORAH_API_KEY=           MyFatoorah (charges in KWD)
# MYFATOORAH_BASE_URL=          optional; https://apitest.myfatoorah.com for test mode
